meta {
  name: reset password
  type: http
  seq: 6
}

post {
  url: http://localhost:8000/auth/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "token": "df6a2a1a679648b6ad59ca99f3f789c3",
    "password": "abcdef"
  }
}

script:post-response {
  let data = res.body;
  bru.setEnvVar("token", data.access_token);
  
}
